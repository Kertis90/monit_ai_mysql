<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="mysql-ai-monitoring" version="24.0.0">
  <diagram id="arch-main" name="Архитектура и потоки данных">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════ ЗАГОЛОВОК ═══════════ -->
        <mxCell id="title" value="MySQL AI Monitoring — архитектура, потоки данных и порты" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- ═══════════ КЛАСТЕР КЕМЕРОВО ═══════════ -->
        <mxCell id="cl1" value="Кластер: Кемерово (kemerovo)&#10;10.1.0.0/24" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="330" height="400" as="geometry" />
        </mxCell>

        <mxCell id="cl1p" value="PRIMARY 10.1.0.1&#10;━━━━━━━━━━━━━━━━━&#10;MySQL 8.0          :3306&#10;mysqld_exporter  :9104&#10;node_exporter    :9100" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="145" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cl1r" value="REPLICA 10.1.0.2&#10;━━━━━━━━━━━━━━━━━&#10;MySQL 8.0 (read_only)  :3306&#10;mysqld_exporter        :9104&#10;node_exporter          :9100" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="345" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e-repl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cl1p" target="cl1r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-repl-l" value="асинхронная репликация&#10;binlog → relay log, TCP :3306" style="edgeLabel;html=1;align=center;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-repl">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════ КЛАСТЕР N ═══════════ -->
        <mxCell id="clN" value="Кластер: Новосибирск, Омск, … ×N городов&#10;(идентичная структура: primary + replica,&#10;экспортёры :9104 / :9100 на каждом сервере)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="330" height="110" as="geometry" />
        </mxCell>

        <!-- ═══════════ СЕРВЕР МОНИТОРИНГА ═══════════ -->
        <mxCell id="mon" value="Сервер мониторинга (OEL8)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="560" height="780" as="geometry" />
        </mxCell>

        <mxCell id="prom" value="Prometheus  :9090&#10;━━━━━━━━━━━━━━━&#10;scrape_interval: 15s&#10;retention: 30d&#10;TSDB /var/lib/prometheus" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="550" y="150" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="graf" value="Grafana  :3000&#10;━━━━━━━━━━━━&#10;4 дашборда:&#10;1860 / 7362 /&#10;11323 / 7371" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="850" y="150" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="am" value="Alertmanager  :9093&#10;━━━━━━━━━━━━━━━━&#10;critical → webhook + email&#10;warning  → webhook" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="550" y="330" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="AI Agent (FastAPI)  :5001&#10;━━━━━━━━━━━━━━━━━━━━━&#10;GET  /            веб-интерфейс&#10;WS   /ws          чат, стриминг&#10;POST /webhook   алерты от AM&#10;POST /chat       REST-чат&#10;GET  /status,/clusters,/alerts" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="490" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="registry" value="clusters.json (реестр городов)&#10;manage_cluster.sh apply:&#10;→ генерирует prometheus.yml&#10;→ reload Prometheus (без рестарта)&#10;→ копирует реестр агенту + restart" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="700" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- ═══════════ УДАЛЁННАЯ LLM ═══════════ -->
        <mxCell id="llm" value="Удалённая LLM&#10;━━━━━━━━━━━━━━━━━&#10;POST {URL}/v1/chat/completions&#10;HTTPS :443&#10;Authorization: Bearer &lt;token&gt;&#10;stream: true (SSE)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="480" width="310" height="130" as="geometry" />
        </mxCell>

        <!-- ═══════════ DBA / БРАУЗЕР ═══════════ -->
        <mxCell id="dba" value="DBA (браузер)&#10;━━━━━━━━━━━━&#10;чат + метрики + алерты" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="700" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="smtp" value="SMTP-сервер&#10;:587 (email-алерты,&#10;опционально)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="300" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════ ПОТОКИ ═══════════ -->

        <!-- Prometheus scrape primary -->
        <mxCell id="e-sc1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="prom" target="cl1p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sc1-l" value="PULL scrape / 15s&#10;HTTP GET :9104 /metrics&#10;HTTP GET :9100 /metrics" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-sc1">
          <mxGeometry x="-0.15" relative="1" as="geometry" />
        </mxCell>

        <!-- Prometheus scrape replica -->
        <mxCell id="e-sc2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.8;entryX=1;entryY=0.3;" edge="1" parent="1" source="prom" target="cl1r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sc2-l" value="PULL :9104 / :9100" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-sc2">
          <mxGeometry x="0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- Prometheus scrape N -->
        <mxCell id="e-scN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="prom" target="clN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-scN-l" value="PULL ×N кластеров" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-scN">
          <mxGeometry x="0.2" relative="1" as="geometry" />
        </mxCell>

        <!-- Grafana -> Prometheus -->
        <mxCell id="e-gp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="graf" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gp-l" value="PromQL&#10;HTTP :9090/api/v1" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-gp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Prometheus -> Alertmanager -->
        <mxCell id="e-pa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prom" target="am">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pa-l" value="PUSH алерты&#10;HTTP POST :9093/api/v2/alerts" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-pa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alertmanager -> Agent webhook -->
        <mxCell id="e-aw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="am" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-aw-l" value="webhook&#10;HTTP POST :5001/webhook" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-aw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alertmanager -> SMTP -->
        <mxCell id="e-smtp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="am" target="smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-smtp-l" value="SMTP :587 (critical)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Agent -> Prometheus -->
        <mxCell id="e-ap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0;exitY=0.3;entryX=0.15;entryY=1;" edge="1" parent="1" source="agent" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ap-l" value="PromQL query + query_range&#10;HTTP GET :9090/api/v1&#10;(текущие метрики + история)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-ap">
          <mxGeometry x="0.25" relative="1" as="geometry" />
        </mxCell>

        <!-- Agent -> LLM -->
        <mxCell id="e-allm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-allm-l" value="HTTPS :443, Bearer&#10;POST /chat/completions&#10;← SSE stream (токены)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;fontStyle=1" vertex="1" connectable="0" parent="e-allm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- registry -> prom & agent -->
        <mxCell id="e-reg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="registry" target="am">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="600" y="670" /><mxPoint x="530" y="670" /><mxPoint x="530" y="280" /><mxPoint x="600" y="280" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-reg1-l" value="конфигурация" style="edgeLabel;html=1;fontSize=9;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-reg1">
          <mxGeometry x="0.6" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-reg2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="registry" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DBA -> Agent -->
        <mxCell id="e-dba" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=3;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="dba" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dba-l" value="HTTP :5001 (UI, REST)&#10;WSS :5001/ws (чат-стриминг)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;fontStyle=1" vertex="1" connectable="0" parent="e-dba">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DBA -> Grafana -->
        <mxCell id="e-dbag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="dba" target="graf">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1340" y="205" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-dbag-l" value="HTTP :3000 (дашборды)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-dbag">
          <mxGeometry x="0.3" relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════ ЛЕГЕНДА / ТАБЛИЦА ПОРТОВ ═══════════ -->
        <mxCell id="legend" value="ПОРТЫ И ПРОТОКОЛЫ&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;3306   MySQL + репликация            TCP&#10;9100   node_exporter /metrics        HTTP (pull)&#10;9104   mysqld_exporter /metrics      HTTP (pull)&#10;9090   Prometheus API + UI           HTTP&#10;9093   Alertmanager API + UI         HTTP&#10;3000   Grafana UI                    HTTP&#10;5001   AI Agent: UI + REST + WS      HTTP / WSS&#10;443    Удалённая LLM (Bearer, SSE)   HTTPS&#10;587    SMTP (опционально)            TLS&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;Направление стрелки = инициатор соединения" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="420" height="260" as="geometry" />
        </mxCell>

        <!-- ═══════════ СЦЕНАРИИ ═══════════ -->
        <mxCell id="flows" value="КЛЮЧЕВЫЕ ПОТОКИ&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;① Метрики: exporters → Prometheus (pull, 15s) → TSDB&#10;② Алерт: Prometheus → Alertmanager → POST /webhook →&#10;    Agent тянет метрики+историю 2ч → LLM → диагноз&#10;③ Чат: DBA → WSS /ws → Agent распознаёт город+период →&#10;    PromQL → LLM (stream) → токены → браузер&#10;④ Конфиг: manage_cluster.sh apply → prometheus.yml +&#10;    reload + clusters.json → restart агента" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="880" width="500" height="220" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="agent-flow" name="AI-агент: путь вопроса">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="AI-агент: путь одного вопроса — от чата до ответа" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-lane1" value="Браузер" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p2-lane2" value="Агент (FastAPI, сервер мониторинга)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="80" width="520" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p2-lane3" value="Внешние источники" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="80" width="300" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p2-lane4" value="Модель (LLM)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="80" width="300" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p2-q" value="Вопрос в чате&#10;«напиши запрос топ-5 договоров»" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-ws" value="WebSocket /ws&#10;вопрос сохраняется в историю ДО ответа" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-job" value="jobs.start()&#10;задача живёт в памяти агента:&#10;закрытая вкладка ответ не отменяет" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="460" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2-ctx" value="build_chat_context()&#10;кластер по городу, период по словам&#10;блоки: метрики, история, алерты, схема" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="210" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-prom" value="Prometheus&#10;query / query_range" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="210" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p2-snap" value="Снимок схемы&#10;из хранилища агента, не из базы" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="270" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p2-msg" value="Сообщения для модели&#10;[system] промпт, 15 правил&#10;[history] последние реплики + выжимка&#10;[user] блоки контекста + ## Вопрос" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="460" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-tools" value="llm_with_tools(): раунды инструментов&#10;порция 4, потом вопрос человеку&#10;повтор вызова не дёргает базу заново" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="400" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-model1" value="Модель просит данные&#10;tool_calls: get_schema, run_sql …" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1230" y="400" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-db" value="MySQL кластера&#10;SELECT / SHOW / EXPLAIN&#10;сессия READ ONLY" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-ask" value="Порция кончилась → вопрос человеку:&#10;«сделано N запросов, продолжаем?»&#10;ответ кнопкой или словом в чат" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="480" width="460" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2-stream" value="stream_answer(): стриминг токенов&#10;вырезаются &lt;think&gt; и &lt;tool_call&gt;&#10;вызовы штатным полем собираются из кусков" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-model2" value="Модель пишет ответ&#10;SSE, по токену" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1230" y="560" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p2-guard" value="Страховки после ответа&#10;① в ответе SELECT вместо результата → выполнить и переспросить&#10;② ответ-вступление → попросить договорить, показанное стереть&#10;③ сохранить в историю" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="650" width="460" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2-out" value="Ответ в чате&#10;числа + запрос рядом для проверки" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-q" target="p2-ws">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-ws" target="p2-job">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-job" target="p2-ctx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" value="метрики" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-ctx" target="p2-prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" value="схема" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-ctx" target="p2-snap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-ctx" target="p2-msg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-msg" target="p2-tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="инструменты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-tools" target="p2-model1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e9" value="tool_calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-model1" target="p2-tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e10" value="run_sql" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-tools" target="p2-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e11" value="порция исчерпана" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-tools" target="p2-ask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e12" value="«нет» / молчание" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-ask" target="p2-stream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e13" value="«да»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-ask" target="p2-tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e14" value="данные собраны" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-tools" target="p2-stream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-stream" target="p2-model2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e16" value="токены" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-model2" target="p2-stream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-stream" target="p2-guard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-guard" target="p2-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-note" value="Почему задача отдельно от сокета&#10;&#10;Раньше генерация шла прямо в обработчике: закрыл вкладку — и разбор,&#10;на который потрачена минута сбора метрик и чтения логов, пропадал.&#10;Теперь сокет только пересказывает задачу и может переключаться&#10;между разговорами, не обрывая ни один из них." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=10;verticalAlign=top;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="810" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-note2" value="Что НЕ может модель&#10;&#10;Ходить в базу, на серверы и в Prometheus напрямую.&#10;Она только просит агента — списком инструментов.&#10;Всё, что уходит в базу, проходит проверку агента:&#10;разрешены SELECT, SHOW, EXPLAIN, DESCRIBE, WITH." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=10;verticalAlign=top;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="820" width="630" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="agent-schema" name="Схема БД и поиск таблицы">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-title" value="Схема базы: съёмка, хранение и три пути к нужной таблице" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3-g1" value="СЪЁМКА — по кнопке, администратором, в фоне" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="700" height="420" as="geometry" />
        </mxCell>
        <mxCell id="p3-src" value="information_schema&#10;&#10;TABLES — таблицы и представления&#10;COLUMNS — столбцы, типы, COMMENT&#10;STATISTICS — индексы, кардинальность&#10;KEY_COLUMN_USAGE — внешние ключи" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-fallback" value="Если COMMENT пуст:&#10;SHOW TABLE STATUS&#10;SHOW FULL COLUMNS&#10;&#10;не SHOW CREATE TABLE — данные те же,&#10;но без разбора DDL регулярками" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-guess" value="Внешних ключей нет (MyISAM и др.):&#10;связи предполагаются по именам столбцов&#10;и помечаются «по имени столбца»&#10;имена вроде id исключены" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="400" y="250" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-snapshot" value="Снимок схемы (JSON у агента)&#10;&#10;20 баз · 80 таблиц на базу · 40 представлений&#10;300 таблиц с подробностями · 120 столбцов" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-index" value="Смысловой индекс&#10;по вектору на таблицу, отдельной строкой&#10;документ = имя + комментарий + столбцы" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-src" target="p3-snapshot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" value="пусто" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-src" target="p3-fallback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e3" value="комментарии" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-fallback" target="p3-snapshot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-guess" target="p3-snapshot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e5" value="векторизация при съёмке" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-snapshot" target="p3-index">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-g2" value="ПОИСК — на каждый вопрос, от дешёвого к дорогому" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="730" height="420" as="geometry" />
        </mxCell>
        <mxCell id="p3-q" value="Вопрос: «покажи учётные записи»" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="810" y="120" width="670" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-w1" value="1 · По буквам&#10;полное имя база.таблица → имя отдельным словом →&#10;по комментарию, сравнение по основе в 5 букв&#10;цена: 0 запросов" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="810" y="180" width="670" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-w2" value="2 · По смыслу, векторами&#10;векторизуется только вопрос; близость — скалярное произведение&#10;нормированных векторов, порог 0.30, до 3 таблиц&#10;цена: 1 короткий запрос к /embeddings" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="810" y="268" width="670" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-w3" value="3 · Выбором генеративной модели&#10;список таблиц с комментариями + вопрос → имена&#10;ответ проверяется по снимку: чего нет — отбрасывается&#10;цена: 1 короткий диалог" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="810" y="356" width="670" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p3-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-q" target="p3-w1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e7" value="не нашлось" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-w1" target="p3-w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e8" value="векторов нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-w2" target="p3-w3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-out" value="Блоки, которые уходят в подсказку модели&#10;&#10;## Что есть в базе — имена и комментарии всех таблиц&#10;## база.таблица — столбцы, типы, ключи, связи, индексы&#10;&#10;Столбцы существуют ТОЛЬКО здесь: правило промпта запрещает перечислять&#10;их по общему списку и достраивать имена по смыслу." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-sql" value="Ограда SQL — одна на все пути&#10;&#10;разрешены SELECT SHOW EXPLAIN DESCRIBE DESC WITH&#10;одна инструкция, ; внутри отклоняется&#10;/*! и /*+ отклоняются целиком — MySQL их исполняет&#10;чёрный список: INSERT UPDATE DELETE DROP ALTER GRANT …&#10;сессия READ ONLY, LIMIT дописывается" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="780" y="530" width="730" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-index" target="p3-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-w3" target="p3-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e11" value="запрос модели" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p3-out" target="p3-sql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
