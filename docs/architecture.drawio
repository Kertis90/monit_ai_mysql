<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="mysql-ai-monitoring" version="24.0.0">
  <diagram id="arch-main" name="Архитектура и потоки данных">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════ ЗАГОЛОВОК ═══════════ -->
        <mxCell id="title" value="MySQL AI Monitoring — архитектура, потоки данных и порты" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- ═══════════ КЛАСТЕР КЕМЕРОВО ═══════════ -->
        <mxCell id="cl1" value="Кластер: Кемерово (kemerovo)&#10;10.1.0.0/24" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="330" height="400" as="geometry" />
        </mxCell>

        <mxCell id="cl1p" value="PRIMARY 10.1.0.1&#10;━━━━━━━━━━━━━━━━━&#10;MySQL 8.0          :3306&#10;mysqld_exporter  :9104&#10;node_exporter    :9100" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="145" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cl1r" value="REPLICA 10.1.0.2&#10;━━━━━━━━━━━━━━━━━&#10;MySQL 8.0 (read_only)  :3306&#10;mysqld_exporter        :9104&#10;node_exporter          :9100" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="345" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e-repl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cl1p" target="cl1r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-repl-l" value="асинхронная репликация&#10;binlog → relay log, TCP :3306" style="edgeLabel;html=1;align=center;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-repl">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════ КЛАСТЕР N ═══════════ -->
        <mxCell id="clN" value="Кластер: Новосибирск, Омск, … ×N городов&#10;(идентичная структура: primary + replica,&#10;экспортёры :9104 / :9100 на каждом сервере)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="330" height="110" as="geometry" />
        </mxCell>

        <!-- ═══════════ СЕРВЕР МОНИТОРИНГА ═══════════ -->
        <mxCell id="mon" value="Сервер мониторинга (OEL8)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="560" height="780" as="geometry" />
        </mxCell>

        <mxCell id="prom" value="Prometheus  :9090&#10;━━━━━━━━━━━━━━━&#10;scrape_interval: 15s&#10;retention: 30d&#10;TSDB /var/lib/prometheus" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="550" y="150" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="graf" value="Grafana  :3000&#10;━━━━━━━━━━━━&#10;4 дашборда:&#10;1860 / 7362 /&#10;11323 / 7371" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="850" y="150" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="am" value="Alertmanager  :9093&#10;━━━━━━━━━━━━━━━━&#10;critical → webhook + email&#10;warning  → webhook" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="550" y="330" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="AI Agent (FastAPI)  :5001&#10;━━━━━━━━━━━━━━━━━━━━━&#10;GET  /            веб-интерфейс&#10;WS   /ws          чат, стриминг&#10;POST /webhook   алерты от AM&#10;POST /chat       REST-чат&#10;GET  /status,/clusters,/alerts" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="490" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="registry" value="clusters.json (реестр городов)&#10;manage_cluster.sh apply:&#10;→ генерирует prometheus.yml&#10;→ reload Prometheus (без рестарта)&#10;→ копирует реестр агенту + restart" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="700" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- ═══════════ УДАЛЁННАЯ LLM ═══════════ -->
        <mxCell id="llm" value="Удалённая LLM&#10;━━━━━━━━━━━━━━━━━&#10;POST {URL}/v1/chat/completions&#10;HTTPS :443&#10;Authorization: Bearer &lt;token&gt;&#10;stream: true (SSE)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="480" width="310" height="130" as="geometry" />
        </mxCell>

        <!-- ═══════════ DBA / БРАУЗЕР ═══════════ -->
        <mxCell id="dba" value="DBA (браузер)&#10;━━━━━━━━━━━━&#10;чат + метрики + алерты" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="700" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="smtp" value="SMTP-сервер&#10;:587 (email-алерты,&#10;опционально)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="300" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════ ПОТОКИ ═══════════ -->

        <!-- Prometheus scrape primary -->
        <mxCell id="e-sc1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="prom" target="cl1p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sc1-l" value="PULL scrape / 15s&#10;HTTP GET :9104 /metrics&#10;HTTP GET :9100 /metrics" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-sc1">
          <mxGeometry x="-0.15" relative="1" as="geometry" />
        </mxCell>

        <!-- Prometheus scrape replica -->
        <mxCell id="e-sc2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0;exitY=0.8;entryX=1;entryY=0.3;" edge="1" parent="1" source="prom" target="cl1r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sc2-l" value="PULL :9104 / :9100" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-sc2">
          <mxGeometry x="0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- Prometheus scrape N -->
        <mxCell id="e-scN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="prom" target="clN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-scN-l" value="PULL ×N кластеров" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-scN">
          <mxGeometry x="0.2" relative="1" as="geometry" />
        </mxCell>

        <!-- Grafana -> Prometheus -->
        <mxCell id="e-gp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="graf" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gp-l" value="PromQL&#10;HTTP :9090/api/v1" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-gp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Prometheus -> Alertmanager -->
        <mxCell id="e-pa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prom" target="am">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pa-l" value="PUSH алерты&#10;HTTP POST :9093/api/v2/alerts" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-pa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alertmanager -> Agent webhook -->
        <mxCell id="e-aw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="am" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-aw-l" value="webhook&#10;HTTP POST :5001/webhook" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-aw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Alertmanager -> SMTP -->
        <mxCell id="e-smtp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="am" target="smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-smtp-l" value="SMTP :587 (critical)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Agent -> Prometheus -->
        <mxCell id="e-ap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=0;exitY=0.3;entryX=0.15;entryY=1;" edge="1" parent="1" source="agent" target="prom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ap-l" value="PromQL query + query_range&#10;HTTP GET :9090/api/v1&#10;(текущие метрики + история)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-ap">
          <mxGeometry x="0.25" relative="1" as="geometry" />
        </mxCell>

        <!-- Agent -> LLM -->
        <mxCell id="e-allm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-allm-l" value="HTTPS :443, Bearer&#10;POST /chat/completions&#10;← SSE stream (токены)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;fontStyle=1" vertex="1" connectable="0" parent="e-allm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- registry -> prom & agent -->
        <mxCell id="e-reg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="registry" target="am">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="600" y="670" /><mxPoint x="530" y="670" /><mxPoint x="530" y="280" /><mxPoint x="600" y="280" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-reg1-l" value="конфигурация" style="edgeLabel;html=1;fontSize=9;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-reg1">
          <mxGeometry x="0.6" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-reg2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="registry" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DBA -> Agent -->
        <mxCell id="e-dba" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=3;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="dba" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dba-l" value="HTTP :5001 (UI, REST)&#10;WSS :5001/ws (чат-стриминг)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;fontStyle=1" vertex="1" connectable="0" parent="e-dba">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DBA -> Grafana -->
        <mxCell id="e-dbag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="dba" target="graf">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1340" y="205" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-dbag-l" value="HTTP :3000 (дашборды)" style="edgeLabel;html=1;fontSize=10;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-dbag">
          <mxGeometry x="0.3" relative="1" as="geometry" />
        </mxCell>

        <!-- ═══════════ ЛЕГЕНДА / ТАБЛИЦА ПОРТОВ ═══════════ -->
        <mxCell id="legend" value="ПОРТЫ И ПРОТОКОЛЫ&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;3306   MySQL + репликация            TCP&#10;9100   node_exporter /metrics        HTTP (pull)&#10;9104   mysqld_exporter /metrics      HTTP (pull)&#10;9090   Prometheus API + UI           HTTP&#10;9093   Alertmanager API + UI         HTTP&#10;3000   Grafana UI                    HTTP&#10;5001   AI Agent: UI + REST + WS      HTTP / WSS&#10;443    Удалённая LLM (Bearer, SSE)   HTTPS&#10;587    SMTP (опционально)            TLS&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;Направление стрелки = инициатор соединения" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#ffffff;strokeColor=#666666;fontFamily=Courier New;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="420" height="260" as="geometry" />
        </mxCell>

        <!-- ═══════════ СЦЕНАРИИ ═══════════ -->
        <mxCell id="flows" value="КЛЮЧЕВЫЕ ПОТОКИ&#10;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#10;① Метрики: exporters → Prometheus (pull, 15s) → TSDB&#10;② Алерт: Prometheus → Alertmanager → POST /webhook →&#10;    Agent тянет метрики+историю 2ч → LLM → диагноз&#10;③ Чат: DBA → WSS /ws → Agent распознаёт город+период →&#10;    PromQL → LLM (stream) → токены → браузер&#10;④ Конфиг: manage_cluster.sh apply → prometheus.yml +&#10;    reload + clusters.json → restart агента" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="880" width="500" height="220" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
